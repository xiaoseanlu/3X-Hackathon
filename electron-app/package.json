{
  "name": "turbotax-business-tax-assistant",
  "version": "0.1.0",
  "description": "TurboTax Business Tax Assistant — macOS menu bar widget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --dmg",
    "build:zip": "electron-builder --mac --zip"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.intuit.turbotax.business-tax-assistant",
    "productName": "TurboTax Business Tax",
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../prototype",
        "to": "prototype",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "assets/app-icon.icns",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "TurboTax Business Tax",
      "window": { "width": 540, "height": 380 }
    }
  }
}
